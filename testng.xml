<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="cocoine-suite" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="org.cocoine.core.TestListener"/>
    </listeners>
    <test name="api-tests">
        <packages>
            <package name="org.cocoine.tests.api.gorest"/>
        </packages>
    </test>
    <test name="ui-tests">
        <packages>
            <package name="org.cocoine.tests.ui.gorest"/>
        </packages>
    </test>
</suite>
