<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="cocoine-suite">
    <listeners>
        <listener class-name="org.cocoine.core.TestListener"/>
    </listeners>
    <test name="api-tests">
        <classes>
            <class name="org.cocoine.tests.api.SampleApiTest"/>
            <class name="org.cocoine.tests.api.GoRestApiTest"/>
        </classes>
    </test>
    <test name="ui-tests">
        <classes>
            <class name="org.cocoine.tests.ui.SampleUiTest"/>
            <class name="org.cocoine.tests.ui.GoRestUiTest"/>
        </classes>
    </test>
</suite>
