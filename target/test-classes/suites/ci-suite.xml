<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ci-suite" parallel="tests" thread-count="6">
    <listeners>
        <listener class-name="org.cocoine.framework.listener.FrameworkListener"/>
    </listeners>
    <test name="contract">
        <groups>
            <run>
                <include name="contract"/>
            </run>
        </groups>
        <packages>
            <package name="org.cocoine.tests.contract"/>
        </packages>
    </test>
    <test name="gorest-api-read">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="BAT"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="org.cocoine.tests.api.GoRestApiReadTest"/>
        </classes>
    </test>
    <test name="gorest-api-crud" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
                <include name="P1"/>
            </run>
        </groups>
        <classes>
            <class name="org.cocoine.tests.api.GoRestApiCrudTest"/>
        </classes>
    </test>
    <test name="gorest-ui">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="BAT"/>
                <include name="regression"/>
                <include name="P1"/>
                <include name="P2"/>
            </run>
        </groups>
        <packages>
            <package name="org.cocoine.tests.ui"/>
        </packages>
    </test>
</suite>
