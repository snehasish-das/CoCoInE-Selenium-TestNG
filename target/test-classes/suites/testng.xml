<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="cocoine-framework-suite" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="org.cocoine.framework.listener.FrameworkListener"/>
    </listeners>
    <test name="all-tests">
        <packages>
            <package name="org.cocoine.tests.*"/>
        </packages>
    </test>
</suite>
