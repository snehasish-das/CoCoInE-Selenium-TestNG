<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="sanity-suite" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="org.cocoine.framework.listener.FrameworkListener"/>
    </listeners>
    <test name="sanity-tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="BAT"/>
            </run>
        </groups>
        <classes>
            <class name="org.cocoine.tests.api.GoRestApiReadTest"/>
            <class name="org.cocoine.tests.ui.GoRestHomePageTest"/>
        </classes>
    </test>
</suite>
