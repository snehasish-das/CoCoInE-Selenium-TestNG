<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="prod-suite" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="org.cocoine.framework.listener.FrameworkListener"/>
    </listeners>
    <test name="gorest-api-read">
        <classes>
            <class name="org.cocoine.tests.api.GoRestApiReadTest"/>
        </classes>
    </test>
    <test name="gorest-api-crud-policy-gated" preserve-order="true">
        <classes>
            <class name="org.cocoine.tests.api.GoRestApiCrudTest"/>
        </classes>
    </test>
    <test name="gorest-ui-navigation-policy-gated">
        <classes>
            <class name="org.cocoine.tests.ui.GoRestVisualAndEventTest">
                <methods>
                    <include name="traceAndInspectorReadyUserJourneyValidation"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
