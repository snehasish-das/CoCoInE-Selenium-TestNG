<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ci-suite" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="org.cocoine.framework.listener.FrameworkListener"/>
    </listeners>
    <test name="contract">
        <groups>
            <run>
                <include name="contract"/>
            </run>
        </groups>
        <packages>
            <package name="org.cocoine.tests.contract"/>
        </packages>
    </test>
    <test name="api-integration">
        <groups>
            <run>
                <include name="integration"/>
                <include name="component"/>
            </run>
        </groups>
        <packages>
            <package name="org.cocoine.tests.api"/>
        </packages>
    </test>
    <test name="e2e">
        <groups>
            <run>
                <include name="e2e"/>
            </run>
        </groups>
        <packages>
            <package name="org.cocoine.tests.ui"/>
        </packages>
    </test>
</suite>
